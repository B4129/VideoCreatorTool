<Window x:Class="VideoCreatorWPF.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VideoCreatorWPF.Converters"
        Title="動画エクスポート" Height="600" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#18181b">
    <Window.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#3f3f46" BorderThickness="1">
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Height="50" Background="#3c3c3c">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="動画エクスポート" FontSize="18" Foreground="White" Margin="15,10"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,8">
                        <Button Content="プリセット保存" Command="{Binding SavePresetCommand}"
                                Background="#3f3f46" Foreground="White" BorderThickness="0"
                                Padding="10,5" Margin="0,0,5,0" Height="34"/>
                        <Button Content="プリセット読込" Command="{Binding LoadPresetCommand}"
                                Background="#3f3f46" Foreground="White" BorderThickness="0"
                                Padding="10,5" Height="34"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" Margin="20">
                <StackPanel>
                    <!-- Output path -->
                    <TextBlock Text="出力先:" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OutputPath}" Margin="0,0,5,0"
                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                 Padding="5" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="参照..." Command="{Binding BrowseOutputCommand}"
                                Background="#3f3f46" Foreground="White" BorderThickness="0"/>
                    </Grid>

                    <!-- Resolution preset -->
                    <TextBlock Text="解像度:" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <ComboBox SelectedItem="{Binding ResolutionPreset}" Margin="0,0,0,15"
                              Background="#27272a" Foreground="White" BorderBrush="#3f3f46">
                        <ComboBoxItem Content="4K (3840x2160)"/>
                        <ComboBoxItem Content="FHD (1920x1080)"/>
                        <ComboBoxItem Content="HD (1280x720)"/>
                        <ComboBoxItem Content="縦型 9:16 (1080x1920)"/>
                    </ComboBox>

                    <!-- Custom resolution -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ExportWidth}" Background="#27272a" Foreground="White"
                                 BorderBrush="#3f3f46" Padding="5" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="#999999"/>
                        <TextBox Grid.Column="2" Text="{Binding ExportHeight}" Background="#27272a" Foreground="White"
                                 BorderBrush="#3f3f46" Padding="5" VerticalContentAlignment="Center"/>
                    </Grid>

                    <!-- Frame rate -->
                    <TextBlock Text="フレームレート:" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <ComboBox SelectedItem="{Binding ExportFrameRate}" Margin="0,0,0,15"
                              Background="#27272a" Foreground="White" BorderBrush="#3f3f46">
                        <ComboBoxItem Content="60 fps"/>
                        <ComboBoxItem Content="30 fps"/>
                        <ComboBoxItem Content="24 fps"/>
                        <ComboBoxItem Content="15 fps"/>
                    </ComboBox>

                    <!-- Quality (video bitrate) -->
                    <TextBlock Text="品質 (ビットレート):" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <Slider Minimum="1000" Maximum="20000" Value="{Binding ExportVideoBitrate}"
                            TickFrequency="1000" IsSnapToTickEnabled="True" Margin="0,0,0,5"
                            Background="#27272a"/>
                    <TextBlock Text="{Binding ExportVideoBitrate, StringFormat={}{0} kbps}"
                               Foreground="#999999" Margin="0,0,0,15"/>

                    <!-- Export range -->
                    <TextBlock Text="エクスポート範囲:" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="全て" IsChecked="{Binding ExportRange, Converter={StaticResource StringToBoolConverter}, ConverterParameter=all}"
                                     GroupName="ExportRange" Margin="0,0,15,0" Foreground="White"/>
                        <RadioButton Content="選択範囲" IsChecked="{Binding ExportRange, Converter={StaticResource StringToBoolConverter}, ConverterParameter=selection}"
                                     GroupName="ExportRange" Margin="0,0,15,0" Foreground="White"/>
                        <RadioButton Content="指定範囲" IsChecked="{Binding ExportRange, Converter={StaticResource StringToBoolConverter}, ConverterParameter=range}"
                                     GroupName="ExportRange" Foreground="White"/>
                    </StackPanel>

                    <!-- Range selector (conditional) -->
                    <Border Visibility="{Binding ShowRangeSelector, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#3c3c3c" Padding="10" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="開始:" Foreground="#999999" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding RangeStartFrame}" Background="#27272a" Foreground="White"
                                         BorderBrush="#3f3f46" Padding="5" VerticalContentAlignment="Center"/>
                                <TextBlock Text="{Binding RangeStartTimeText}" Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="〜" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="#999999" Margin="0,20,0,0"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="終了:" Foreground="#999999" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding RangeEndFrame}" Background="#27272a" Foreground="White"
                                         BorderBrush="#3f3f46" Padding="5" VerticalContentAlignment="Center"/>
                                <TextBlock Text="{Binding RangeEndTimeText}" Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Progress (shown during export) -->
            <Border Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#2d2d30" Padding="20" Margin="20,0,20,10">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" Margin="0,0,0,10"/>
                    <ProgressBar Height="20" Value="{Binding Progress}" Maximum="100"
                                 Background="#27272a" BorderBrush="#3f3f46"/>
                    <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" Foreground="#999999"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Border DockPanel.Dock="Bottom" Background="#3c3c3c" Padding="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="エクスポート開始" Command="{Binding ExportCommand}"
                            Width="140" Height="36" Margin="0,0,10,0"
                            Background="#3b82f6" Foreground="White" BorderThickness="0"
                            IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="キャンセル" Command="{Binding CancelCommand}"
                            Width="100" Height="36"
                            Background="#3f3f46" Foreground="White" BorderThickness="0"
                            IsEnabled="{Binding IsExporting}"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>

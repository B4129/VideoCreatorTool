<UserControl x:Class="VideoCreatorWPF.Views.BGMMgmtPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VideoCreatorWPF.Converters"
             Background="#2d2d30">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <!-- Header -->
        <TextBlock Text="BGM 管理" FontSize="14" Foreground="White" Margin="0,0,0,10"/>

        <!-- BGM file selector -->
        <Border Background="#3c3c3c" Padding="10" Margin="0,0,0,10" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="BGMファイル:" Foreground="#cccccc" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding BGMPath}" Background="#27272a" Foreground="White"
                             BorderBrush="#3f3f46" Padding="3" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="参照..." Command="{Binding BrowseBGMCommand}"
                            Background="#3f3f46" Foreground="White" BorderThickness="0" Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- BGM controls -->
        <Border Background="#3c3c3c" Padding="10" Margin="0,0,0,10" CornerRadius="4">
            <StackPanel>
                <!-- Volume -->
                <TextBlock Text="BGM音量:" Foreground="#cccccc" Margin="0,0,0,5"/>
                <Slider Minimum="0" Maximum="100" Value="{Binding BGMVolume}"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        Margin="0,0,0,5" Background="#27272a"/>
                <TextBlock Text="{Binding BGMVolume, StringFormat={}{0:F0}%}"
                           Foreground="#999999" HorizontalAlignment="Right" Margin="0,0,0,10"/>

                <!-- Loop toggle -->
                <CheckBox Content="ループ再生" IsChecked="{Binding IsBGMLoop}"
                          Foreground="White" Margin="0,0,0,5"/>

                <!-- Fade in/out -->
                <TextBlock Text="フェードイン (秒):" Foreground="#cccccc" Margin="0,5,0,0"/>
                <TextBox Text="{Binding BGMFadeIn}" Background="#27272a" Foreground="White"
                         BorderBrush="#3f3f46" Padding="3" Margin="0,0,0,5"/>

                <TextBlock Text="フェードアウト (秒):" Foreground="#cccccc" Margin="0,5,0,0"/>
                <TextBox Text="{Binding BGMFadeOut}" Background="#27272a" Foreground="White"
                         BorderBrush="#3f3f46" Padding="3" Margin="0,0,0,5"/>
            </StackPanel>
        </Border>

        <!-- Audio level meter -->
        <Border Background="#3c3c3c" Padding="10" Margin="0,0,0,0" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="オーディオレベル:" Foreground="#cccccc" Margin="0,0,0,5"/>
                <Canvas Height="60" Background="#27272a" x:Name="LevelMeterCanvas">
                    <!-- Left channel -->
                    <Rectangle x:Name="LeftLevelBar" Width="20" Height="0" Fill="#00FF00"
                               Canvas.Bottom="5" Canvas.Left="10"/>
                    <Rectangle Width="20" Height="50" Stroke="#3f3f46" StrokeThickness="1"
                               Fill="Transparent" Canvas.Bottom="5" Canvas.Left="10"/>

                    <!-- Right channel -->
                    <Rectangle x:Name="RightLevelBar" Width="20" Height="0" Fill="#00FF00"
                               Canvas.Bottom="5" Canvas.Left="40"/>
                    <Rectangle Width="20" Height="50" Stroke="#3f3f46" StrokeThickness="1"
                               Fill="Transparent" Canvas.Bottom="5" Canvas.Left="40"/>

                    <!-- dB scale -->
                    <TextBlock Text="0dB" Foreground="#666666" FontSize="8"
                               Canvas.Top="8" Canvas.Left="70"/>
                    <TextBlock Text="-20dB" Foreground="#666666" FontSize="8"
                               Canvas.Top="28" Canvas.Left="70"/>
                    <TextBlock Text="-60dB" Foreground="#666666" FontSize="8"
                               Canvas.Top="48" Canvas.Left="70"/>
                </Canvas>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

<Window x:Class="VideoCreatorWPF.Views.VoiceSynthesisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音声合成設定" Height="700" Width="500"
        Background="#2d2d2d"
        Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="音声合成設定" FontSize="20" FontWeight="Bold" Foreground="#e0e0e0"/>
                <TextBlock Text="VOICEVOXの音声合成パラメータを調整" FontSize="12"
                           Foreground="#999999" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Character selection -->
            <Border Grid.Row="2" Background="#1e1e1e" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="キャラクター" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Speaker selection -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="キャラクター選択" FontSize="12" Foreground="#999999" Margin="0,0,0,6"/>
                        <ComboBox x:Name="SpeakerCombo" Height="36" FontSize="13"
                                  Background="#3c3c3c" Foreground="#e0e0e0"
                                  BorderBrush="#555555"
                                  SelectionChanged="SpeakerCombo_SelectionChanged"/>
                    </StackPanel>

                    <!-- Style selection -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="スタイル/感情" FontSize="12" Foreground="#999999" Margin="0,0,0,6"/>
                        <ComboBox x:Name="StyleCombo" Height="36" FontSize="13"
                                  Background="#3c3c3c" Foreground="#e0e0e0"
                                  BorderBrush="#555555"/>
                    </StackPanel>

                    <!-- Preview button -->
                    <Button Content="▶ プレビュー再生" Height="40" FontSize="14"
                            Background="#3b82f6" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,16"
                            Click="PreviewButton_Click"/>

                    <Separator Background="#3c3c3c" Margin="0,8,0,16"/>

                    <!-- Preset management -->
                    <TextBlock Text="プリセット管理" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                    <!-- Preset selection -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PresetCombo" Grid.Column="0" Height="32" FontSize="12"
                                      Background="#3c3c3c" Foreground="#e0e0e0"
                                      BorderBrush="#555555"/>
                            <Button Grid.Column="2" Content="読込" Width="60" Height="32" FontSize="11"
                                    Background="#3b82f6" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Click="LoadPreset_Click"/>
                            <Button Grid.Column="4" Content="保存" Width="60" Height="32" FontSize="11"
                                    Background="#22c55e" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Click="SavePreset_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Preset save dialog -->
                    <StackPanel x:Name="PresetSavePanel" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PresetNameBox" Grid.Column="0" Height="32" FontSize="12"
                                     Background="#3c3c3c" Foreground="#e0e0e0"
                                     BorderBrush="#555555" Padding="6,4"
                                     Text="プリセット名"/>
                            <Button Grid.Column="2" Content="OK" Width="50" Height="32" FontSize="11"
                                    Background="#22c55e" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Click="PresetConfirmSave_Click"/>
                            <Button Grid.Column="4" Content="取消" Width="50" Height="32" FontSize="11"
                                    Background="#666666" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Click="PresetCancelSave_Click"/>
                        </Grid>
                    </StackPanel>

                    <Separator Background="#3c3c3c" Margin="0,0,0,16"/>

                    <!-- Parameters -->
                    <TextBlock Text="パラメータ" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Speed -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="話速" Grid.Column="0" FontSize="12"
                                       VerticalAlignment="Center" Foreground="#e0e0e0"/>
                            <Slider x:Name="SpeedSlider" Grid.Column="1"
                                    Minimum="0.5" Maximum="2.0" Value="1.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    ValueChanged="ParameterSlider_ValueChanged"/>
                            <TextBox x:Name="SpeedBox" Grid.Column="2" Text="1.0"
                                     Height="28" FontSize="11" Padding="4,2"
                                     Background="#3c3c3c" Foreground="#e0e0e0"
                                     BorderBrush="#555555" TextAlignment="Center"
                                     TextChanged="ParameterBox_TextChanged"/>
                        </Grid>
                    </StackPanel>

                    <!-- Pitch -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音高" Grid.Column="0" FontSize="12"
                                       VerticalAlignment="Center" Foreground="#e0e0e0"/>
                            <Slider x:Name="PitchSlider" Grid.Column="1"
                                    Minimum="-0.15" Maximum="0.15" Value="0.0"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    ValueChanged="ParameterSlider_ValueChanged"/>
                            <TextBox x:Name="PitchBox" Grid.Column="2" Text="0.00"
                                     Height="28" FontSize="11" Padding="4,2"
                                     Background="#3c3c3c" Foreground="#e0e0e0"
                                     BorderBrush="#555555" TextAlignment="Center"
                                     TextChanged="ParameterBox_TextChanged"/>
                        </Grid>
                    </StackPanel>

                    <!-- Intonation -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="抑揚" Grid.Column="0" FontSize="12"
                                       VerticalAlignment="Center" Foreground="#e0e0e0"/>
                            <Slider x:Name="IntonationSlider" Grid.Column="1"
                                    Minimum="0.0" Maximum="2.0" Value="1.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    ValueChanged="ParameterSlider_ValueChanged"/>
                            <TextBox x:Name="IntonationBox" Grid.Column="2" Text="1.0"
                                     Height="28" FontSize="11" Padding="4,2"
                                     Background="#3c3c3c" Foreground="#e0e0e0"
                                     BorderBrush="#555555" TextAlignment="Center"
                                     TextChanged="ParameterBox_TextChanged"/>
                        </Grid>
                    </StackPanel>

                    <!-- Volume -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音量" Grid.Column="0" FontSize="12"
                                       VerticalAlignment="Center" Foreground="#e0e0e0"/>
                            <Slider x:Name="VolumeSlider" Grid.Column="1"
                                    Minimum="0.0" Maximum="2.0" Value="1.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    ValueChanged="ParameterSlider_ValueChanged"/>
                            <TextBox x:Name="VolumeBox" Grid.Column="2" Text="1.0"
                                     Height="28" FontSize="11" Padding="4,2"
                                     Background="#3c3c3c" Foreground="#e0e0e0"
                                     BorderBrush="#555555" TextAlignment="Center"
                                     TextChanged="ParameterBox_TextChanged"/>
                        </Grid>
                    </StackPanel>

                    <Separator Background="#3c3c3c" Margin="0,8,0,16"/>

                    <!-- Timing -->
                    <TextBlock Text="タイミング調整" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Start silence -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="開始無音" Grid.Column="0" FontSize="12"
                                       VerticalAlignment="Center" Foreground="#e0e0e0"/>
                            <Slider x:Name="StartSilenceSlider" Grid.Column="1"
                                    Minimum="0" Maximum="1000" Value="200"
                                    TickFrequency="50" IsSnapToTickEnabled="True"
                                    ValueChanged="TimingSlider_ValueChanged"/>
                            <TextBox x:Name="StartSilenceBox" Grid.Column="2" Text="200"
                                     Height="28" FontSize="11" Padding="4,2"
                                     Background="#3c3c3c" Foreground="#e0e0e0"
                                     BorderBrush="#555555" TextAlignment="Center"
                                     TextChanged="TimingBox_TextChanged"/>
                        </Grid>
                        <TextBlock Text="セリフ前の無音時間（ms）" FontSize="10" Foreground="#666666" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- End silence -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="終了無音" Grid.Column="0" FontSize="12"
                                       VerticalAlignment="Center" Foreground="#e0e0e0"/>
                            <Slider x:Name="EndSilenceSlider" Grid.Column="1"
                                    Minimum="0" Maximum="1000" Value="200"
                                    TickFrequency="50" IsSnapToTickEnabled="True"
                                    ValueChanged="TimingSlider_ValueChanged"/>
                            <TextBox x:Name="EndSilenceBox" Grid.Column="2" Text="200"
                                     Height="28" FontSize="11" Padding="4,2"
                                     Background="#3c3c3c" Foreground="#e0e0e0"
                                     BorderBrush="#555555" TextAlignment="Center"
                                     TextChanged="TimingBox_TextChanged"/>
                        </Grid>
                        <TextBlock Text="セリフ後の無音時間（ms）" FontSize="10" Foreground="#666666" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="リセット" Width="100" Height="36" FontSize="12"
                        Background="#666666" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="ResetButton_Click" Margin="0,0,8,0"/>
                <Button Content="適用" Width="100" Height="36" FontSize="12"
                        Background="#3b82f6" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="ApplyButton_Click" Margin="0,0,8,0"/>
                <Button Content="閉じる" Width="100" Height="36" FontSize="12"
                        Background="#4a4a4a" Foreground="#e0e0e0"
                        BorderThickness="0" Cursor="Hand"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>

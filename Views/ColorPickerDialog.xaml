<Window x:Class="VideoCreatorWPF.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="カラーピッカー" Height="300" Width="400"
        Background="#2d2d2d" Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="カラーピッカー" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="RGB値または16進数で色を選択" FontSize="11" Foreground="#999999" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Color preview -->
        <Border Grid.Row="2" Background="#1e1e1e" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <!-- Preview -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="プレビュー" FontSize="12" Foreground="#999999" Margin="0,0,0,6"/>
                    <Border x:Name="ColorPreview" Height="60" Background="White"
                            BorderBrush="#555555" BorderThickness="1" CornerRadius="4"/>
                </StackPanel>

                <!-- RGB Sliders -->
                <StackPanel Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" Grid.Column="0" Foreground="#ff6666" FontWeight="Bold"/>
                        <Slider x:Name="RSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                ValueChanged="Slider_ValueChanged"/>
                        <TextBox x:Name="RBox" Grid.Column="2" Text="255" Height="28"
                                 Background="#3c3c3c" Foreground="#e0e0e0"
                                 BorderBrush="#555555" TextAlignment="Center"
                                 TextChanged="TextBox_TextChanged"/>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="G" Grid.Column="0" Foreground="#66ff66" FontWeight="Bold"/>
                        <Slider x:Name="GSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                ValueChanged="Slider_ValueChanged"/>
                        <TextBox x:Name="GBox" Grid.Column="2" Text="255" Height="28"
                                 Background="#3c3c3c" Foreground="#e0e0e0"
                                 BorderBrush="#555555" TextAlignment="Center"
                                 TextChanged="TextBox_TextChanged"/>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="B" Grid.Column="0" Foreground="#6666ff" FontWeight="Bold"/>
                        <Slider x:Name="BSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                ValueChanged="Slider_ValueChanged"/>
                        <TextBox x:Name="BBox" Grid.Column="2" Text="255" Height="28"
                                 Background="#3c3c3c" Foreground="#e0e0e0"
                                 BorderBrush="#555555" TextAlignment="Center"
                                 TextChanged="TextBox_TextChanged"/>
                    </Grid>
                </StackPanel>

                <!-- Hex input -->
                <StackPanel>
                    <TextBlock Text="16進数" FontSize="12" Foreground="#999999" Margin="0,0,0,6"/>
                    <TextBox x:Name="HexBox" Text="#FFFFFF" Height="32" FontSize="13"
                             Background="#3c3c3c" Foreground="#e0e0e0"
                             BorderBrush="#555555" Padding="6,4"
                             TextChanged="TextBox_TextChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Height="36" FontSize="12"
                    Background="#3b82f6" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="OKButton_Click" Margin="0,0,8,0"/>
            <Button Content="キャンセル" Width="80" Height="36" FontSize="12"
                    Background="#666666" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="VideoCreatorWPF.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:VideoCreatorWPF.Converters"
             mc:Ignorable="d"
             d:DesignWidth="640" d:DesignHeight="360">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="Black" BorderBrush="#3f3f46" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Preview display area -->
            <Grid Grid.Row="0" x:Name="PreviewGrid" Background="Black" AllowDrop="True"
                  Drop="PreviewGrid_Drop" DragOver="PreviewGrid_DragOver">
                <!-- Video display for timeline blocks -->
                <MediaElement x:Name="VideoPlayer" Stretch="Uniform"
                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                              ScrubbingEnabled="True"
                              Visibility="{Binding CurrentVideoPath, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Fallback: black background when no video -->
                <Grid Background="Black"
                      Visibility="{Binding CurrentVideoPath, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                <!-- Standing image display -->
                <Image x:Name="StandingImage" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                       Visibility="{Binding StandingImagePath, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StandingImagePath}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!-- Emotion effect overlay -->
                <Image x:Name="EmotionEffect" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Width="200" Height="200" Visibility="{Binding EmotionEffectPath, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmotionEffectPath}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!-- Canvas for overlays (grid, safe area, onion skin) -->
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                    <!-- Grid lines -->
                    <Canvas x:Name="GridLinesCanvas" Visibility="Collapsed">
                        <!-- Grid of thirds -->
                        <Line X1="0" Y1="0.33" X2="1" Y2="0.33" Stroke="#40FFFFFF" StrokeThickness="1" Canvas.Top="0" Canvas.Left="0"/>
                        <Line X1="0" Y1="0.66" X2="1" Y2="0.66" Stroke="#40FFFFFF" StrokeThickness="1" Canvas.Top="0" Canvas.Left="0"/>
                        <Line X1="0.33" Y1="0" X2="0.33" Y2="1" Stroke="#40FFFFFF" StrokeThickness="1" Canvas.Top="0" Canvas.Left="0"/>
                        <Line X1="0.66" Y1="0" X2="0.66" Y2="1" Stroke="#40FFFFFF" StrokeThickness="1" Canvas.Top="0" Canvas.Left="0"/>
                    </Canvas>

                    <!-- Safe area guides -->
                    <Canvas x:Name="SafeAreaCanvas" Visibility="Collapsed">
                        <!-- 90% safe area (5% margin on each side) -->
                        <Rectangle x:Name="SafeArea90" Stroke="#00FF00" StrokeThickness="1"
                                   StrokeDashArray="4 2"/>
                        <!-- 93% safe area (3.5% margin on each side) -->
                        <Rectangle x:Name="SafeArea93" Stroke="#FFFF00" StrokeThickness="1"
                                   StrokeDashArray="4 2"/>
                    </Canvas>

                    <!-- Onion skin overlays -->
                    <Canvas x:Name="OnionSkinCanvas" Visibility="Collapsed">
                        <Border Background="#20FFFFFF" Opacity="0.3" Width="100" Height="60"
                                Canvas.Left="50" Canvas.Top="50"/>
                    </Canvas>
                </Canvas>

                <!-- Subtitle overlay -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Background="#80000000" Padding="10" Margin="20,0,20,20">
                    <ItemsControl ItemsSource="{Binding CurrentTextBlocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="White"
                                           FontSize="{Binding FontSize}"
                                           FontFamily="{Binding FontFamily}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Drop hint -->
                <TextBlock x:Name="DropHintText" Text="ここに動画をドラッグ＆ドロップ"
                           Foreground="#666666" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Removed: Preview settings toolbar -->

            <!-- Seek bar overlay at bottom of preview (hidden by default, shown on hover) -->
            <Border x:Name="SeekBarOverlay" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="#80000000" Padding="15,8" Margin="0,0,0,40">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=PreviewGrid}" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current position -->
                    <TextBlock Grid.Column="0" Text="{Binding CurrentPositionText}" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" FontWeight="Bold" Width="50"/>

                    <!-- Seek slider -->
                    <Slider x:Name="PreviewSeekSlider" Grid.Column="1" Height="22"
                            Minimum="0"
                            Maximum="{Binding DataContext.TotalFrames, RelativeSource={RelativeSource AncestorType=Window}}"
                            Value="{Binding CurrentFrame, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="False"
                            ValueChanged="PreviewSeekSlider_ValueChanged"/>

                    <!-- Duration -->
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="White"
                               VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Width="50"/>
                </Grid>
            </Border>

            <!-- Playback controls (removed) -->
        </Grid>
    </Border>
</UserControl>

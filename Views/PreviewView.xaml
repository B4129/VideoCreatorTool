<UserControl x:Class="VideoCreatorWPF.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:VideoCreatorWPF.Converters"
             mc:Ignorable="d"
             d:DesignWidth="640" d:DesignHeight="360">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="Black" BorderBrush="#3f3f46" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Preview display area -->
            <Grid Grid.Row="0" x:Name="PreviewGrid" Background="Black" AllowDrop="True"
                  Drop="PreviewGrid_Drop" DragOver="PreviewGrid_DragOver">
                <!-- Video display -->
                <MediaElement x:Name="VideoPlayer" Stretch="Uniform"
                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                              ScrubbingEnabled="True"/>

                <!-- Canvas for overlays (grid, safe area, onion skin) -->
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                    <!-- Grid lines -->
                    <Canvas x:Name="GridLinesCanvas" Visibility="Collapsed">
                        <!-- Grid of thirds -->
                        <Line X1="0" Y1="0.33" X2="1" Y2="0.33" Stroke="#40FFFFFF" StrokeThickness="1" Canvas.Top="0" Canvas.Left="0"/>
                        <Line X1="0" Y1="0.66" X2="1" Y2="0.66" Stroke="#40FFFFFF" StrokeThickness="1" Canvas.Top="0" Canvas.Left="0"/>
                        <Line X1="0.33" Y1="0" X2="0.33" Y2="1" Stroke="#40FFFFFF" StrokeThickness="1" Canvas.Top="0" Canvas.Left="0"/>
                        <Line X1="0.66" Y1="0" X2="0.66" Y2="1" Stroke="#40FFFFFF" StrokeThickness="1" Canvas.Top="0" Canvas.Left="0"/>
                    </Canvas>

                    <!-- Safe area guides -->
                    <Canvas x:Name="SafeAreaCanvas" Visibility="Collapsed" SizeChanged="SafeAreaCanvas_SizeChanged">
                        <!-- 90% safe area (5% margin on each side) -->
                        <Rectangle x:Name="SafeArea90" Stroke="#00FF00" StrokeThickness="1"
                                   StrokeDashArray="4 2"/>
                        <!-- 93% safe area (3.5% margin on each side) -->
                        <Rectangle x:Name="SafeArea93" Stroke="#FFFF00" StrokeThickness="1"
                                   StrokeDashArray="4 2"/>
                    </Canvas>

                    <!-- Onion skin overlays -->
                    <Canvas x:Name="OnionSkinCanvas" Visibility="Collapsed">
                        <Border Background="#20FFFFFF" Opacity="0.3" Width="100" Height="60"
                                Canvas.Left="50" Canvas.Top="50"/>
                    </Canvas>
                </Canvas>

                <!-- Subtitle overlay -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Background="#80000000" Padding="10" Margin="20,0,20,20">
                    <TextBlock Text="{Binding CurrentText}" Foreground="White"
                               FontSize="16" HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Drop hint -->
                <TextBlock x:Name="DropHintText" Text="ここに動画をドラッグ＆ドロップ"
                           Foreground="#666666" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Preview settings toolbar -->
            <Border Grid.Row="1" Background="#27272a" BorderBrush="#3f3f46" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <!-- Resolution selector -->
                    <TextBlock Text="解像度:" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="ResolutionCombo" Width="80" Height="22" Margin="0,0,10,0"
                              SelectionChanged="ResolutionCombo_SelectionChanged">
                        <ComboBoxItem Content="フル" Tag="1.0" IsSelected="True"/>
                        <ComboBoxItem Content="1/2" Tag="0.5"/>
                        <ComboBoxItem Content="1/4" Tag="0.25"/>
                    </ComboBox>

                    <!-- Grid toggle -->
                    <ToggleButton x:Name="GridToggle" Width="24" Height="22" Margin="0,0,3,0"
                                  Click="GridToggle_Click" ToolTip="グリッド表示">
                        <Path Data="M3,3H21V21H3V3M5,5V19H19V5H5M7,7H17V17H7V7M9,9V15H15V9H9Z"
                              Fill="White" Stretch="Uniform" Width="14" Height="14"/>
                    </ToggleButton>

                    <!-- Safe area toggle -->
                    <ToggleButton x:Name="SafeAreaToggle" Width="24" Height="22" Margin="0,0,3,0"
                                  Click="SafeAreaToggle_Click" ToolTip="セーフエリア表示">
                        <Rectangle Stroke="White" StrokeThickness="1.5" Width="14" Height="10"
                                   RadiusX="1" RadiusY="1"/>
                    </ToggleButton>

                    <!-- Onion skin toggle -->
                    <ToggleButton x:Name="OnionSkinToggle" Width="24" Height="22" Margin="0,0,3,0"
                                  Click="OnionSkinToggle_Click" ToolTip="オニオンスキン">
                        <Path Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M12,2A7,7 0 0,0 5,9C5,11.38 6.19,13.47 8,14.74V17A1,1 0 0,0 9,18H15A1,1 0 0,0 16,17V14.74C17.81,13.47 19,11.38 19,9A7,7 0 0,0 12,2M9,21V20H15V21A1,1 0 0,1 14,22H10A1,1 0 0,1 9,21Z"
                              Fill="White" Stretch="Uniform" Width="14" Height="14"/>
                    </ToggleButton>

                    <Separator Width="1" Background="#3f3f46" Margin="5,4"/>

                    <!-- Fit toggle -->
                    <TextBlock Text="表示:" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="5,0,3,0"/>
                    <ComboBox x:Name="FitModeCombo" Width="80" Height="22"
                              SelectionChanged="FitModeCombo_SelectionChanged">
                        <ComboBoxItem Content="全体表示" IsSelected="True"/>
                        <ComboBoxItem Content="拡大"/>
                        <ComboBoxItem Content="100%"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Playback controls -->
            <Border Grid.Row="2" Background="#27272a" BorderBrush="#3f3f46" BorderThickness="0,1,0,0">
                <Grid>
                    <!-- Seek bar - full width -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="{Binding CurrentPositionText}" Foreground="#a1a1aa"
                                   VerticalAlignment="Center" Margin="0,0,5,0" Width="50" TextAlignment="Right"/>
                        <Slider x:Name="SeekSlider" Width="300" Height="25"
                                Minimum="0" Maximum="{Binding Duration}"
                                Value="{Binding CurrentPosition, Mode=TwoWay}"
                                Thumb.DragStarted="SeekSlider_DragStarted"
                                Thumb.DragCompleted="SeekSlider_DragCompleted"/>
                        <TextBlock Text="{Binding DurationText}" Foreground="#a1a1aa"
                                   VerticalAlignment="Center" Margin="5,0,0,0" Width="50"/>
                    </StackPanel>

                    <!-- Playback buttons - centered -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Content="⏮" Click="RestartButton_Click" Width="50" Height="40"
                                Background="Transparent" BorderThickness="1" BorderBrush="#3f3f46"
                                Foreground="White" FontSize="18" Cursor="Hand" ToolTip="最初に戻る"/>
                        <Button x:Name="PlayPauseButton" Content="▶" Click="PlayPauseButton_Click" Width="50" Height="40"
                                Background="Transparent" BorderThickness="1" BorderBrush="#3f3f46"
                                Foreground="White" FontSize="18" Cursor="Hand" ToolTip="再生/一時停止"/>
                        <Button Content="⏹" Click="StopButton_Click" Width="50" Height="40"
                                Background="Transparent" BorderThickness="1" BorderBrush="#3f3f46"
                                Foreground="White" FontSize="18" Cursor="Hand" ToolTip="停止"/>
                    </StackPanel>

                    <!-- Frame counter -->
                    <TextBlock Text="{Binding CurrentFrame, StringFormat='Frame: {0}'}"
                               Foreground="#a1a1aa" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

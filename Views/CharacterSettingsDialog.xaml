<Window x:Class="VideoCreatorWPF.Views.CharacterSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="キャラクター設定" Height="650" Width="950"
        Background="#2d2d2d"
        Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="キャラクター設定" FontSize="20" FontWeight="Bold" Foreground="#e0e0e0" VerticalAlignment="Center"/>
            <TextBlock Text="各キャラクターの詳細設定を行う" FontSize="12" Foreground="#999999"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Main content: Left panel (character list) + Right panel (tabs) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Character list -->
            <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="キャラクター一覧" FontSize="13" FontWeight="Bold"
                               Foreground="#e0e0e0" Margin="10,10,0,8"/>
                    <ListBox x:Name="CharacterList" Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" SelectionChanged="CharacterList_SelectionChanged"
                             Margin="4,0,4,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Border Width="32" Height="32" CornerRadius="16"
                                            Background="{Binding Color}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharConverter}}"
                                                   Foreground="White" FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="#e0e0e0"
                                               VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="+ 新規追加" Height="32" FontSize="12"
                            Background="#3b82f6" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="8,4,8,8"
                            Click="AddCharacter_Click"/>
                </StackPanel>
            </Border>

            <!-- Right: Tab control for detailed settings -->
            <Border Grid.Column="2" Background="#1e1e1e" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="8">
                <TabControl x:Name="SettingsTabs" Background="Transparent" BorderThickness="0">
                    <!-- Tab 1: Voice settings -->
                    <TabItem Header="音声">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel>
                                <TextBlock Text="VOICEVOX連携設定" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Speaker selection -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="話者選択" FontSize="12" Foreground="#999999" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="SpeakerCombo" Height="36" FontSize="13"
                                              Background="#3c3c3c" Foreground="#e0e0e0"
                                              BorderBrush="#555555"
                                              SelectionChanged="SpeakerCombo_SelectionChanged"/>
                                </StackPanel>

                                <!-- Style selection -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="スタイル/感情" FontSize="12" Foreground="#999999" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="StyleCombo" Height="36" FontSize="13"
                                              Background="#3c3c3c" Foreground="#e0e0e0"
                                              BorderBrush="#555555"/>
                                </StackPanel>

                                <!-- Preview button -->
                                <Button Content="▶ プレビュー再生" Height="40" FontSize="13"
                                        Background="#3b82f6" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" Margin="0,0,0,16"
                                        Click="PreviewVoice_Click"/>

                                <Separator Background="#3c3c3c" Margin="0,0,0,16"/>

                                <!-- Sliders -->
                                <TextBlock Text="音声パラメータ" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                                <!-- Speed -->
                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="話速" Grid.Column="0" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.5" Maximum="2.0"
                                                Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                ValueChanged="VoiceSlider_ValueChanged"/>
                                        <TextBox x:Name="SpeedBox" Grid.Column="2" Text="1.0" Height="26" FontSize="10"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"
                                                 TextAlignment="Center" TextChanged="VoiceBox_TextChanged"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Pitch -->
                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="音高" Grid.Column="0" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider x:Name="PitchSlider" Grid.Column="1" Minimum="-0.15" Maximum="0.15"
                                                Value="0.0" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                ValueChanged="VoiceSlider_ValueChanged"/>
                                        <TextBox x:Name="PitchBox" Grid.Column="2" Text="0.00" Height="26" FontSize="10"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"
                                                 TextAlignment="Center" TextChanged="VoiceBox_TextChanged"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Intonation -->
                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="抑揚" Grid.Column="0" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider x:Name="IntonationSlider" Grid.Column="1" Minimum="0.0" Maximum="2.0"
                                                Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                ValueChanged="VoiceSlider_ValueChanged"/>
                                        <TextBox x:Name="IntonationBox" Grid.Column="2" Text="1.0" Height="26" FontSize="10"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"
                                                 TextAlignment="Center" TextChanged="VoiceBox_TextChanged"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Volume -->
                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="音量" Grid.Column="0" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0.0" Maximum="2.0"
                                                Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                ValueChanged="VoiceSlider_ValueChanged"/>
                                        <TextBox x:Name="VolumeBox" Grid.Column="2" Text="1.0" Height="26" FontSize="10"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"
                                                 TextAlignment="Center" TextChanged="VoiceBox_TextChanged"/>
                                    </Grid>
                                </StackPanel>

                                <Separator Background="#3c3c3c" Margin="0,8,0,12"/>

                                <!-- Timing -->
                                <TextBlock Text="タイミング調整" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="開始無音" Grid.Column="0" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider x:Name="StartSilenceSlider" Grid.Column="1" Minimum="0" Maximum="1000"
                                                Value="200" TickFrequency="50" IsSnapToTickEnabled="True"
                                                ValueChanged="TimingSlider_ValueChanged"/>
                                        <TextBox x:Name="StartSilenceBox" Grid.Column="2" Text="200" Height="26" FontSize="10"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"
                                                 TextAlignment="Center" TextChanged="TimingBox_TextChanged"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="終了無音" Grid.Column="0" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider x:Name="EndSilenceSlider" Grid.Column="1" Minimum="0" Maximum="1000"
                                                Value="200" TickFrequency="50" IsSnapToTickEnabled="True"
                                                ValueChanged="TimingSlider_ValueChanged"/>
                                        <TextBox x:Name="EndSilenceBox" Grid.Column="2" Text="200" Height="26" FontSize="10"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"
                                                 TextAlignment="Center" TextChanged="TimingBox_TextChanged"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Subtitle/Decoration -->
                    <TabItem Header="字幕・装飾">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel>
                                <TextBlock Text="字幕スタイル設定" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Font family -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="フォント" FontSize="12" Foreground="#999999" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="FontFamilyCombo" Height="36" FontSize="13"
                                              Background="#3c3c3c" Foreground="#e0e0e0"
                                              BorderBrush="#555555"/>
                                </StackPanel>

                                <!-- Font size -->
                                <StackPanel Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="フォントサイズ" Grid.Column="0" FontSize="12" VerticalAlignment="Center"/>
                                        <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="12" Maximum="96"
                                                Value="32" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <TextBox x:Name="FontSizeBox" Grid.Column="2" Text="32" Height="26" FontSize="10"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"
                                                 TextAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Font color -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="文字色" FontSize="12" Foreground="#999999" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="FontColorBox" Width="100" Height="32" FontSize="12" Padding="6,4"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555">
                                            <TextBox.Text>#FFFFFF</TextBox.Text>
                                        </TextBox>
                                        <Border x:Name="FontColorPreview" Width="32" Height="32" Margin="8,0,0,0"
                                                Background="#FFFFFF" BorderBrush="#555555" BorderThickness="1"/>
                                        <Button Content="選択..." Width="70" Height="32" Margin="8,0,0,0" FontSize="11"
                                                Background="#4a4a4a" Foreground="#e0e0e0"
                                                BorderBrush="#555555" Click="PickFontColor_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <Separator Background="#3c3c3c" Margin="0,12,0,12"/>

                                <!-- Outline -->
                                <TextBlock Text="縁取り設定" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="太さ" Grid.Column="0" FontSize="12" VerticalAlignment="Center"/>
                                        <Slider x:Name="OutlineWidthSlider" Grid.Column="1" Minimum="0" Maximum="8"
                                                Value="2" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                        <TextBox x:Name="OutlineWidthBox" Grid.Column="2" Text="2" Height="26" FontSize="10"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"
                                                 TextAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="縁取り色" FontSize="12" Foreground="#999999" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="OutlineColorBox" Width="100" Height="32" FontSize="12" Padding="6,4"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555">
                                            <TextBox.Text>#000000</TextBox.Text>
                                        </TextBox>
                                        <Border x:Name="OutlineColorPreview" Width="32" Height="32" Margin="8,0,0,0"
                                                Background="#000000" BorderBrush="#555555" BorderThickness="1"/>
                                        <Button Content="選択..." Width="70" Height="32" Margin="8,0,0,0" FontSize="11"
                                                Background="#4a4a4a" Foreground="#e0e0e0"
                                                BorderBrush="#555555" Click="PickOutlineColor_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <Separator Background="#3c3c3c" Margin="0,12,0,12"/>

                                <!-- Position -->
                                <TextBlock Text="表示位置" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X位置 (%)" FontSize="11" Foreground="#999999" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TextPosXBox" Height="28" FontSize="12" Padding="6,4"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"
                                                 Text="50"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y位置 (%)" FontSize="11" Foreground="#999999" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TextPosYBox" Height="28" FontSize="12" Padding="6,4"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"
                                                 Text="85"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: Standing Image -->
                    <TabItem Header="立ち絵・演出">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel>
                                <TextBlock Text="立ち絵設定" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Image path -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="立ち絵画像" FontSize="12" Foreground="#999999" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="StandingImagePath" Height="32" FontSize="12" Padding="6,4"
                                                 Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"
                                                 Grid.Column="0"/>
                                        <Button Content="参照..." Height="32" FontSize="11" Grid.Column="2"
                                                Background="#4a4a4a" Foreground="#e0e0e0"
                                                BorderBrush="#555555" Click="BrowseStandingImage_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Image preview -->
                                <Border Height="150" Background="#2a2a2a" BorderBrush="#3c3c3c" BorderThickness="1"
                                        CornerRadius="4" Margin="0,0,0,16">
                                    <Image x:Name="StandingImagePreview" Stretch="Uniform"/>
                                </Border>

                                <Separator Background="#3c3c3c" Margin="0,0,0,16"/>

                                <!-- Lip sync -->
                                <TextBlock Text="リップシンク設定" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                <CheckBox x:Name="LipSyncCheck" Content="リップシンクを有効にする（音素連動）"
                                          IsChecked="True" Margin="0,0,0,12"
                                          Foreground="#e0e0e0"/>

                                <!-- Blinking -->
                                <TextBlock Text="自動まばたき" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                <CheckBox x:Name="BlinkingCheck" Content="ランダムに目を閉じる"
                                          IsChecked="True" Margin="0,0,0,12"
                                          Foreground="#e0e0e0"/>

                                <Separator Background="#3c3c3c" Margin="0,8,0,12"/>

                                <!-- Emotion poses -->
                                <TextBlock Text="感情ポーズ紐付け" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                                <StackPanel Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="タグ" Grid.Column="0" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="画像パス" Grid.Column="1" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="" Grid.Column="2" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <ListBox x:Name="EmotionList" Background="#2a2a2a" BorderBrush="#3c3c3c"
                                         Margin="0,0,0,8" MaxHeight="150">
                                    <ListBoxItem>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="[喜]" Grid.Column="0" FontSize="10" Height="24"
                                                     Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"/>
                                            <TextBox Text="" Grid.Column="1" FontSize="10" Height="24" Margin="4,0,0,0"
                                                     Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555555"/>
                                            <Button Content="参照" Grid.Column="2" Height="24" Margin="4,0,0,0" FontSize="9"
                                                    Background="#4a4a4a" Foreground="#e0e0e0" BorderBrush="#555555"/>
                                        </Grid>
                                    </ListBoxItem>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 4: Substitution Dictionary -->
                    <TabItem Header="置換辞書">
                        <StackPanel Margin="16">
                            <TextBlock Text="インラインアイコン辞書" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="特定の単語（[tag] や :tag:）を画像に自動置換するためのルールを管理します"
                                       FontSize="11" Foreground="#999999" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <!-- Dictionary management grid -->
                            <Border Background="#2a2a2a" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="4" Height="350">
                                <DataGrid x:Name="DictionaryGrid" Background="Transparent" BorderThickness="0"
                                          AutoGenerateColumns="False" CanUserAddRows="True"
                                          SelectionMode="Single" FontSize="11">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="検索キー" Binding="{Binding SearchKey}" Width="100"/>
                                        <DataGridTemplateColumn Header="画像パス" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="50"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ImagePath}" Grid.Column="0"
                                                                   VerticalAlignment="Center" Margin="4,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Button Content="..." Grid.Column="1" Height="22" FontSize="9"
                                                                Background="#4a4a4a" Foreground="#e0e0e0"
                                                                BorderBrush="#555555" Click="BrowseDictionaryImage_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="サイズ倍率" Binding="{Binding HeightScale}" Width="70"/>
                                        <DataGridCheckBoxColumn Header="有効" Binding="{Binding IsEnabled}" Width="50"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="行を追加" Width="90" Height="30" FontSize="11"
                                        Background="#3b82f6" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="AddDictionaryRow_Click"/>
                                <Button Content="選択行を削除" Width="100" Height="30" FontSize="11" Margin="8,0,0,0"
                                        Background="#ef4444" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="DeleteDictionaryRow_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="リセット" Width="100" Height="36" FontSize="12"
                    Background="#666666" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="ResetButton_Click" Margin="0,0,8,0"/>
            <Button Content="適用" Width="100" Height="36" FontSize="12"
                    Background="#3b82f6" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="ApplyButton_Click" Margin="0,0,8,0"/>
            <Button Content="閉じる" Width="100" Height="36" FontSize="12"
                    Background="#4a4a4a" Foreground="#e0e0e0"
                    BorderThickness="0" Cursor="Hand"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
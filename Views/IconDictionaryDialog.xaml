<Window x:Class="VideoCreatorWPF.Views.IconDictionaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="インラインアイコン辞書" Height="600" Width="900"
        Background="#2d2d2d"
        Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="インラインアイコン辞書" FontSize="18" FontWeight="Bold" Foreground="#e0e0e0"/>
            <TextBlock Text="特定のテキストを画像に自動置換するルールを管理します"
                       FontSize="12" Foreground="#999999" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Character selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="キャラクター:" FontSize="12" Foreground="#999999" Margin="0,0,0,4"/>
            <ComboBox x:Name="CharacterCombo" Height="32" FontSize="12"
                      Background="#3c3c3c" Foreground="#e0e0e0"
                      BorderBrush="#555555"/>
        </StackPanel>

        <!-- Icon list -->
        <Border Grid.Row="2" Background="#1e1e1e" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="4">
            <ListView x:Name="IconList" Background="Transparent" BorderThickness="0"
                      SelectionMode="Single" Margin="8">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="検索キー" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SearchKey}" Foreground="#e0e0e0" Margin="4,2"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="画像パス" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ImagePath}" Foreground="#999999" Margin="4,2"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ImagePath}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="サイズ倍率" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding HeightScale, StringFormat={}{0:F1}}"
                                               Foreground="#e0e0e0" Margin="4,2"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="状態" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Foreground="{Binding IsEnabled, Converter={StaticResource BoolToColorConverter}}"
                                               Margin="4,2"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Add/Edit form -->
        <Border Grid.Row="3" Background="#1e1e1e" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="4" Margin="0,12,0,0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="検索キー" FontSize="10" Foreground="#999999" Margin="0,0,0,4"/>
                    <TextBox x:Name="SearchKeyBox" Height="28" FontSize="11" Padding="6,4"
                             Background="#3c3c3c" Foreground="#e0e0e0"
                             BorderBrush="#555555"
                             ToolTip="例：[笑], :apple:"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="画像パス" FontSize="10" Foreground="#999999" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImagePathBox" Height="28" FontSize="11" Padding="6,4"
                                 Background="#3c3c3c" Foreground="#e0e0e0"
                                 BorderBrush="#555555" Grid.Column="0"/>
                        <Button Content="参照..." Height="28" FontSize="11"
                                Background="#4a4a4a" Foreground="#e0e0e0"
                                BorderBrush="#555555" Grid.Column="2"
                                Click="BrowseImage_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" Width="100">
                    <TextBlock Text="サイズ倍率" FontSize="10" Foreground="#999999" Margin="0,0,0,4"/>
                    <TextBox x:Name="HeightScaleBox" Height="28" FontSize="11" Padding="6,4"
                             Background="#3c3c3c" Foreground="#e0e0e0"
                             BorderBrush="#555555" Text="1.0"/>
                </StackPanel>

                <!-- Row 1 -->
                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Xオフセット" FontSize="10" Foreground="#999999" Margin="0,0,0,4"/>
                        <TextBox x:Name="OffsetXBox" Height="28" FontSize="11" Padding="6,4"
                                 Background="#3c3c3c" Foreground="#e0e0e0"
                                 BorderBrush="#555555" Text="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Yオフセット" FontSize="10" Foreground="#999999" Margin="0,0,0,4"/>
                        <TextBox x:Name="OffsetYBox" Height="28" FontSize="11" Padding="6,4"
                                 Background="#3c3c3c" Foreground="#e0e0e0"
                                 BorderBrush="#555555" Text="0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="説明（任意）" FontSize="10" Foreground="#999999" Margin="0,0,0,4"/>
                    <TextBox x:Name="DescriptionBox" Height="28" FontSize="11" Padding="6,4"
                             Background="#3c3c3c" Foreground="#e0e0e0"
                             BorderBrush="#555555"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="4" VerticalAlignment="Bottom">
                    <CheckBox x:Name="EnabledCheck" Content="有効" IsChecked="True"
                              Foreground="#e0e0e0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="追加" Width="80" Height="32" FontSize="12"
                    Background="#3b82f6" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="AddButton_Click" Margin="0,0,8,0"/>
            <Button Content="削除" Width="80" Height="32" FontSize="12"
                    Background="#ef4444" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="DeleteButton_Click" Margin="0,0,8,0"/>
            <Button Content="閉じる" Width="80" Height="32" FontSize="12"
                    Background="#4a4a4a" Foreground="#e0e0e0"
                    BorderThickness="0" Cursor="Hand"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

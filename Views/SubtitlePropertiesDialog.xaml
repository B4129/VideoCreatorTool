<Window x:Class="VideoCreatorWPF.Views.SubtitlePropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VideoCreatorWPF.Converters"
        Title="字幕プロパティ" Height="500" Width="350"
        WindowStartupLocation="CenterOwner"
        Background="#2d2d30">
    <Window.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#3f3f46" BorderThickness="1">
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Height="40" Background="#3c3c3c">
                <StackPanel>
                    <TextBlock Text="字幕プロパティ" FontSize="16" Foreground="White" Margin="15,8"/>
                </StackPanel>
            </Border>

            <!-- Properties -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
                <StackPanel Margin="15">
                    <!-- Position -->
                    <TextBlock Text="位置 (%):" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="X:" Foreground="#999999" FontSize="10"/>
                            <TextBox Text="{Binding TextPositionX, StringFormat={}{0:F0}}"
                                     Background="#27272a" Foreground="White"
                                     BorderBrush="#3f3f46" Padding="3"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="," VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center" Margin="0,0,0,5"
                                   Foreground="#999999"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Y:" Foreground="#999999" FontSize="10"/>
                            <TextBox Text="{Binding TextPositionY, StringFormat={}{0:F0}}"
                                     Background="#27272a" Foreground="White"
                                     BorderBrush="#3f3f46" Padding="3"/>
                        </StackPanel>
                    </Grid>

                    <!-- Font size -->
                    <TextBlock Text="フォントサイズ:" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <Slider Minimum="8" Maximum="120" Value="{Binding FontSize}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Margin="0,0,0,15" Background="#27272a"/>
                    <TextBlock Text="{Binding FontSize, StringFormat={}{0:F0} px}"
                               Foreground="#999999" Margin="0,0,0,10"/>

                    <!-- Text color -->
                    <TextBlock Text="テキスト色:" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TextColor}"
                                 Background="#27272a" Foreground="White"
                                 BorderBrush="#3f3f46" Padding="5"/>
                        <Border Grid.Column="1" Background="{Binding TextColor}"
                                BorderBrush="#3f3f46" BorderThickness="1" Margin="5,0,0,0"/>
                    </Grid>

                    <!-- Outline -->
                    <TextBlock Text="縁取り:" Foreground="#cccccc" Margin="0,10,0,5"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="幅:" Foreground="#999999" FontSize="10"/>
                            <TextBox Text="{Binding TextOutlineWidth, StringFormat={}{0:F1}}"
                                     Background="#27272a" Foreground="White"
                                     BorderBrush="#3f3f46" Padding="3"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding TextOutlineColor}"
                                BorderBrush="#3f3f46" BorderThickness="1" Margin="5,18,0,0"/>
                    </Grid>

                    <!-- Shadow toggle -->
                    <CheckBox Content="影を付ける" IsChecked="{Binding HasShadow}"
                              Foreground="White" Margin="0,0,0,15"/>

                    <!-- Fade in -->
                    <TextBlock Text="フェードイン (フレーム):" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding FadeInFrames}"
                             Background="#27272a" Foreground="White"
                             BorderBrush="#3f3f46" Padding="5" Margin="0,0,0,10"/>

                    <!-- Fade out -->
                    <TextBlock Text="フェードアウト (フレーム):" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding FadeOutFrames}"
                             Background="#27272a" Foreground="White"
                             BorderBrush="#3f3f46" Padding="5" Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Border DockPanel.Dock="Bottom" Background="#3c3c3c" Padding="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" Click="OKButton_Click"
                            Width="80" Height="32" Margin="0,0,10,0"
                            Background="#3b82f6" Foreground="White" BorderThickness="0"/>
                    <Button Content="キャンセル" Click="CancelButton_Click"
                            Width="80" Height="32"
                            Background="#3f3f46" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>

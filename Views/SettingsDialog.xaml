<Window x:Class="VideoCreatorWPF.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#18181b"
        DataContext="{Binding Settings, RelativeSource={RelativeSource AncestorType=Window}}">
    <Border BorderBrush="#3f3f46" BorderThickness="1">
        <Border.Resources>
            <Style x:Key="VerticalTabControlStyle" TargetType="TabControl">
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#a1a1aa"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}" Margin="0,0,0,2">
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3f3f46"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#2a2a2a"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#27272a" BorderBrush="#3f3f46" BorderThickness="0,0,0,1" Padding="20,10">
                <TextBlock Text="設定" Foreground="White" FontSize="20" FontWeight="Bold"/>
            </Border>

            <!-- Main content: Tab content only (left panel removed) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tab content (full width) -->
                <Border Grid.Column="0" Background="#18181b">
                    <TabControl x:Name="SettingsTabs" Background="Transparent" BorderThickness="0" Margin="0" TabStripPlacement="Left" Style="{StaticResource VerticalTabControlStyle}">
                        <!-- Tab 1: General -->
                        <TabItem Header="全般">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="テーマ" Foreground="#a1a1aa" FontSize="12" Margin="0,0,0,5"/>
                                    <ComboBox SelectedItem="{Binding Theme}" Height="32" FontSize="12"
                                              Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                              Margin="0,0,0,15">
                                        <ComboBoxItem Content="ダーク"/>
                                        <ComboBoxItem Content="ライト"/>
                                    </ComboBox>

                                    <TextBlock Text="自動保存" Foreground="#a1a1aa" FontSize="12" Margin="0,0,0,5"/>
                                    <CheckBox Content="自動保存を有効にする" IsChecked="{Binding AutoSave}"
                                              Foreground="White" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="間隔（分）:" Foreground="#a1a1aa"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding AutoSaveInterval}" Height="30"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="5,3"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: VOICEVOX -->
                        <TabItem Header="VOICEVOX設定">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="VOICEVOXパス:" Foreground="#a1a1aa" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding VoiceVoxPath}" Height="32"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="6,4" Margin="0,0,5,0"/>
                                        <Button Grid.Column="1" Content="参照" Command="{Binding BrowseVoiceVoxCommand}"
                                                Width="70" Height="32" Background="#4a4a4a" Foreground="White"
                                                BorderBrush="#555555" BorderThickness="0"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 3: Output -->
                        <TabItem Header="出力設定">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="出力ディレクトリ:" Foreground="#a1a1aa" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" Height="32"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="6,4" Margin="0,0,5,0"/>
                                        <Button Grid.Column="1" Content="参照" Command="{Binding BrowseOutputCommand}"
                                                Width="70" Height="32" Background="#4a4a4a" Foreground="White"
                                                BorderBrush="#555555" BorderThickness="0"/>
                                    </Grid>
                                    <TextBlock Text="プロジェクト初期設定" Foreground="#a1a1aa" FontSize="13"
                                               FontWeight="Bold" Margin="0,10,0,10"/>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="デフォルト幅:" Foreground="#a1a1aa"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding DefaultWidth}" Height="30"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="5,3"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="デフォルト高さ:" Foreground="#a1a1aa"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding DefaultHeight}" Height="30"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="5,3"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="デフォルトフレームレート:"
                                                   Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding DefaultFrameRate}" Height="30"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="5,3"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 4: Characters -->
                        <TabItem Header="キャラクター設定">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="キャラクター一覧" Foreground="#a1a1aa" FontSize="13"
                                               FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Button Content="+ 新規追加" Height="32" FontSize="12"
                                            Background="#3b82f6" Foreground="White"
                                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"
                                            Command="{Binding AddCharacterCommand}"/>
                                    <ItemsControl ItemsSource="{Binding Characters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#27272a" BorderBrush="#3f3f46" BorderThickness="1"
                                                        CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" Text="{Binding Name}" Height="30"
                                                                     Background="#1e1e1e" Foreground="White"
                                                                     BorderBrush="#3f3f46" Padding="5,3" Margin="0,0,5,0"/>
                                                            <Button Grid.Column="1" Content="削除" Width="60" Height="30"
                                                                    Background="#ef4444" Foreground="White"
                                                                    BorderThickness="0" Command="{Binding RemoveCharacterCommand}"/>
                                                        </Grid>
                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="カラー:"
                                                                       Foreground="#a1a1aa" VerticalAlignment="Center"
                                                                       Margin="0,0,5,0"/>
                                                            <Border Grid.Column="1" Height="30" Background="{Binding Color}"
                                                                    BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="2"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 5: Inline Icon Dictionary -->
                        <TabItem Header="インラインアイコン辞書">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="インラインアイコン辞書" Foreground="#a1a1aa" FontSize="13"
                                               FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="特定の単語（[tag] や :tag:）を画像に自動置換するためのルール"
                                               Foreground="#71717a" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                    <Button Content="+ 行を追加" Height="32" FontSize="12"
                                            Background="#3b82f6" Foreground="White"
                                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"
                                            Command="{Binding AddDictionaryRowCommand}"/>
                                    <ItemsControl ItemsSource="{Binding InlineIconDictionary}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#27272a" BorderBrush="#3f3f46" BorderThickness="1"
                                                        CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="検索キー:"
                                                                       Foreground="#a1a1aa" VerticalAlignment="Center"
                                                                       Margin="0,0,5,0"/>
                                                            <TextBox Grid.Column="1" Text="{Binding SearchKey}" Height="28"
                                                                     Background="#1e1e1e" Foreground="White"
                                                                     BorderBrush="#3f3f46" Padding="4,3"/>
                                                        </Grid>
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="画像パス:"
                                                                       Foreground="#a1a1aa" VerticalAlignment="Center"
                                                                       Margin="0,0,5,0"/>
                                                            <TextBox Grid.Column="1" Text="{Binding ImagePath}" Height="28"
                                                                     Background="#1e1e1e" Foreground="White"
                                                                     BorderBrush="#3f3f46" Padding="4,3" Margin="0,0,5,0"/>
                                                            <Button Grid.Column="2" Content="参照" Width="60" Height="28"
                                                                    Background="#4a4a4a" Foreground="White"
                                                                    BorderThickness="0" Command="{Binding BrowseImageCommand}"/>
                                                        </Grid>
                                                        <Grid Grid.Row="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="サイズ倍率:"
                                                                       Foreground="#a1a1aa" VerticalAlignment="Center"
                                                                       Margin="0,0,5,0"/>
                                                            <TextBox Grid.Column="1" Text="{Binding HeightScale}" Height="28"
                                                                     Background="#1e1e1e" Foreground="White"
                                                                     BorderBrush="#3f3f46" Padding="4,3"/>
                                                        </Grid>
                                                        <CheckBox Grid.Row="6" Content="有効" IsChecked="{Binding IsEnabled}"
                                                                  Foreground="White" Margin="0,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 6: Voice Synthesis Parameters -->
                        <TabItem Header="音声合成パラメータ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="デフォルト話す速さ" Foreground="#a1a1aa" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.5" Maximum="2.0" Value="{Binding DefaultSpeed}"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,5,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding DefaultSpeed}" Height="28"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="4,2" TextAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="デフォルト音高" Foreground="#a1a1aa" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="-0.15" Maximum="0.15" Value="{Binding DefaultPitch}"
                                                TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,5,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding DefaultPitch}" Height="28"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="4,2" TextAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="デフォルト抑揚" Foreground="#a1a1aa" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.0" Maximum="2.0" Value="{Binding DefaultIntonation}"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,5,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding DefaultIntonation}" Height="28"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="4,2" TextAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="デフォルト音量" Foreground="#a1a1aa" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.0" Maximum="2.0" Value="{Binding DefaultVolume}"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,5,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding DefaultVolume}" Height="28"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="4,2" TextAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="タイミング調整" Foreground="#a1a1aa" FontSize="13"
                                               FontWeight="Bold" Margin="0,10,0,10"/>

                                    <TextBlock Text="開始無音 (ms)" Foreground="#a1a1aa" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="1000" Value="{Binding DefaultStartSilence}"
                                                TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,5,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding DefaultStartSilence}" Height="28"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="4,2" TextAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="終了無音 (ms)" Foreground="#a1a1aa" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="1000" Value="{Binding DefaultEndSilence}"
                                                TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,5,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding DefaultEndSilence}" Height="28"
                                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"
                                                 Padding="4,2" TextAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 7: Shortcuts -->
                        <TabItem Header="ショートカット設定">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="キーボードショートカット" Foreground="#a1a1aa" FontSize="13"
                                               FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="各機能に対するキーボードショートカットを設定します"
                                               Foreground="#71717a" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                               Foreground="#e0e0e0" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding KeySequence}" Height="28"
                                                             Background="#27272a" Foreground="White"
                                                             BorderBrush="#3f3f46" Padding="4,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- Buttons -->
            <Border Grid.Row="2" Background="#27272a" BorderBrush="#3f3f46" BorderThickness="0,1,0,0" Padding="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存" Click="SaveButton_Click"
                            Width="90" Height="32" Margin="0,0,10,0"
                            Background="#3b82f6" Foreground="White" BorderThickness="0"/>
                    <Button Content="キャンセル" Click="CancelButton_Click"
                            Width="90" Height="32"
                            Background="#4a4a4a" Foreground="#e0e0e0" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

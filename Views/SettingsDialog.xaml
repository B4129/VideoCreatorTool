<Window x:Class="VideoCreatorWPF.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#18181b">
    <Border BorderBrush="#3f3f46" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Settings content -->
            <ScrollViewer Grid.Row="0" Padding="20">
                <StackPanel>
                    <!-- VOICEVOX Settings -->
                    <TextBlock Text="VOICEVOX設定" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="VOICEVOXパス:" Foreground="#a1a1aa" Margin="0,5,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding VoiceVoxPath}" Padding="5" Margin="0,0,5,0"
                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"/>
                        <Button Grid.Column="1" Content="参照" Command="{Binding BrowseVoiceVoxCommand}"
                                Width="60" Height="30"/>
                    </Grid>

                    <!-- Output Settings -->
                    <TextBlock Text="出力設定" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>

                    <TextBlock Text="出力ディレクトリ:" Foreground="#a1a1aa" Margin="0,5,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" Padding="5" Margin="0,0,5,0"
                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"/>
                        <Button Grid.Column="1" Content="参照" Command="{Binding BrowseOutputCommand}"
                                Width="60" Height="30"/>
                    </Grid>

                    <!-- Project Defaults -->
                    <TextBlock Text="プロジェクト初期設定" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="デフォルト幅:" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding DefaultWidth}" Padding="5" Margin="0,5"
                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"/>
                        <TextBlock Grid.Column="0" Grid.Row="1" Text="デフォルト高さ:" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding DefaultHeight}" Padding="5" Margin="0,5"
                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"/>
                        <TextBlock Grid.Column="0" Grid.Row="2" Text="デフォルトフレームレート:" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding DefaultFrameRate}" Padding="5" Margin="0,5"
                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"/>
                    </Grid>

                    <!-- Auto-save -->
                    <TextBlock Text="自動保存" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>

                    <CheckBox Content="自動保存を有効にする" IsChecked="{Binding AutoSave}"
                              Foreground="White" Margin="0,5"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="間隔（分）:" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Column="1" Text="{Binding AutoSaveInterval}" Padding="5" Margin="0,5"
                                 Background="#27272a" Foreground="White" BorderBrush="#3f3f46"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Border Grid.Row="1" Background="#27272a" BorderBrush="#3f3f46" BorderThickness="0,1,0,0" Padding="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存" Command="{Binding SaveCommand}"
                            Width="80" Height="30" Margin="0,0,10,0"
                            Background="#3b82f6" Foreground="White" BorderThickness="0"/>
                    <Button Content="キャンセル" Command="{Binding CancelCommand}"
                            Width="80" Height="30"
                            Background="#3f3f46" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
